# self-check report (regenerated by `make check`)
*_check_report.txt

# maintainer/owner tooling — kept locally, never shipped to participating teams
maintainer/

# R / Python / editor / OS cruft
.Rhistory
.RData
.Rproj.user/
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Local agent instructions and working notes. They are not part of the entry.
CLAUDE.md

# Large intermediate generations. Deposit them to Zenodo, not to git.
forecast/out/*.jsonl
forecast/out/*.parquet
forecast/out/*.log

# Smoke-test outputs (--limit). Superseded by the full run.
forecast/out/*_smoke.*
forecast/out/*smoke*
# docs/ is DEPOSITED. METHOD.md and EVIDENCE.md are part of the entry.
